{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.2.1",
  "description": "DeepSeek Harness 桌面 GUI 包装：Electron 壳 + WSL2 dsh web 官方界面",
  "author": "DSH Desktop",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "runtime:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-embedded-runtime.ps1",
    "runtime:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-embedded-runtime.ps1 -Force",
    "runtime:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-embedded-runtime.ps1 -VerifyOnly",
    "start": "npm run build && electron .",
    "start:dev": "npm run build && electron . --dev",
    "smoke": "npm run build && node scripts/smoke.js",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
